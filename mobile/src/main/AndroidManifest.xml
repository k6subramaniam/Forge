<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Health Connect: write completed workouts so they appear in Samsung Health
         (blueprint 3.6). The rationale alias below is required by Health Connect so
         users can see why the permission is requested. -->
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />

    <application
        android:name=".ForgeApplication"
        android:allowBackup="true"
        android:label="Forge"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Health Connect permission rationale on Android 13 and earlier. -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Finished sessions from the watch (Wearable Data Layer, blueprint 3.6).
             The path matches com.forge.core.sync.ForgeWire.SESSION_PATH_PREFIX. -->
        <service
            android:name=".sync.WatchSessionListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/forge/session/"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <!-- Health Connect permission-usage rationale entry point. -->
        <activity-alias
            android:name=".ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>

    <!-- Lets the app detect Health Connect availability on the device. -->
    <queries>
        <intent>
            <action android:name="android.health.connect.action.HEALTH_HOME_SETTINGS" />
        </intent>
    </queries>

</manifest>
